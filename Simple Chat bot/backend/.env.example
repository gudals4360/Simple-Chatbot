# 이 파일을 복사해서 같은 폴더에 .env 로 저장한 뒤 키를 넣으세요.  (cp .env.example .env)
# .env 는 .gitignore 에 들어 있어서 GitHub에 올라가지 않습니다.

# 둘 중 하나만 넣어도 됩니다.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Gemini: https://aistudio.google.com/apikey 에서 복사한 키 전체
GEMINI_API_KEY=

# 선택 설정
DEFAULT_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite
# 화면을 다른 주소(예: Live Server 5500번)에서 띄울 때만 필요
# CORS_ORIGINS=http://127.0.0.1:5500
